# Discord Webhook URL for morning recap
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Anti-Spoiler mode (true = scores and MVPs masked on Discord; false = visible directly)
SPOILER_MODE=true

# Public URL to the GitHub Pages stats dashboard (optional)
DASHBOARD_URL=https://ayoubem.github.io/NbActu/

# Fallback to official NBA English highlights if French highlights are not yet published
FALLBACK_TO_US_HIGHLIGHTS=true

# Optional date override for testing (format YYYYMMDD, leave empty for yesterday/night games)
# OVERRIDE_DATE=20240414
